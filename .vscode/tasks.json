{
  // Shared VS Code tasks for ObscuraLens.
  // Run with Terminal > Run Task, or the Command Palette.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install (editable + dev)",
      "type": "shell",
      "command": "python -m pip install -e \".[dev]\"",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "pytest",
      "args": ["-m", "not integration", "--no-color"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Run live smoke test",
      "type": "shell",
      "command": "python scripts/smoke_live.py",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "ruff check .",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run console",
      "type": "shell",
      "command": "python -m obscuralens",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Serve (web)",
      "type": "shell",
      "command": "python -m obscuralens serve",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "TUI",
      "type": "shell",
      "command": "python -m obscuralens tui",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
