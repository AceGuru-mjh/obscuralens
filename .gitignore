.watch-state.json
watch-report.json

# Personal scratch files do NOT belong here: put your own one-off scripts,
# device-flow tokens and notes in `.git/info/exclude`, which is local-only
# and never shipped. Hiding such patterns in this file would silently mask
# real source files from every future contributor.

# Runtime state produced by the advanced alerts module (webhook config + log)
data/alerts.json

/.venv/
.venv/

# Launcher virtualenv
/.venv-start/
