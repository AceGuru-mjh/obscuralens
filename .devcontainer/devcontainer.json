{
  // ObscuraLens development container.
  // Open this repo in VS Code, then "Reopen in Container".
  "name": "ObscuraLens",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "remoteUser": "vscode",

  // Install the package in editable mode with its dev extras.
  "postCreateCommand": "pip install -e \".[dev]\"",

  // The web UI (python -m obscuralens serve) listens here.
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "ObscuraLens web",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  }
}
