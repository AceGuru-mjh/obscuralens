{# ------------------------------------------------------------------ #}
{# ObscuraLens standalone HTML report template (v5.1)                  #}
{#                                                                      #}
{# Context contract:                                                    #}
{#   sections: [{'title': str,                                          #}
{#               'rows': [[cell, ...], ...],   # first row = header      #}
{#               'notes': str (optional)}]                              #}
{#   meta:     {'title', 'target', 'kind', 'version', 'generated',      #}
{#              'channel',                        # all optional          #}
{#              'band': 'clean|watch|elevated|high|critical',           #}
{#              'score': 0-100, 'top_signals': [str, ...]}              #}
{#                                                                      #}
{# The document is fully self-contained: every style is inline in the   #}
{# single <style> block below, so the report survives being emailed,    #}
{# archived or opened from disk with no network access. Values are      #}
{# escaped through the `esc` filter; notes use `nl2br`. `meta.band` is   #}
{# matched against a fixed list and `meta.score` only ever reaches an    #}
{# attribute through `esc`, so a hostile meta block cannot inject.       #}
{# ------------------------------------------------------------------ #}

{# ---------------- shared macros (defined before use) --------------- #}

{#- badge(text, tone): small coloured pill used in the legend and heads -#}
{% macro badge(text, tone='tone-neutral') -%}
<span class="badge {{ tone|esc }}">{{ text|esc }}</span>
{%- endmacro %}

{#- section_table(section, index): one report section with a data table.
    The first row of `section.rows` is the header row; the rest are body
    rows. Sections without rows still render their title and notes. -#}
{% macro section_table(section, index) -%}
<section class="report-section" aria-labelledby="sec-{{ index }}-heading">
  <div class="section-head">
    <span class="section-index">S{{ index }}</span>
    <h2 id="sec-{{ index }}-heading">{{ section.title|esc }}</h2>
  </div>
  <div class="section-body">
    {% if section.rows %}
    <div class="table-scroll">
      <table class="data-table">
        <caption>{{ section.title|esc }} &mdash; {{ section.rows|length }} row(s)</caption>
        <thead>
          <tr>
            {% for cell in section.rows[0] %}
            <th scope="col">{{ cell|esc }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in section.rows[1:] %}
          <tr>
            {% for cell in row %}
            <td>{{ cell|esc }}</td>
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="empty-state">No rows were collected for this section.</p>
    {% endif %}
    {% if section.notes %}
    <p class="notes">{{ section.notes|nl2br }}</p>
    {% endif %}
  </div>
</section>
{%- endmacro %}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="ObscuraLens v{{ meta.version|esc }}">
<meta name="description" content="ObscuraLens OSINT report for {{ meta.target|esc }}">
<title>{{ meta.title|esc }}</title>
<style>
/* ------------------------------------------------------------------ */
/* Design tokens: dark theme by default, light theme for printing and  */
/* for users whose OS prefers it.                                      */
/* ------------------------------------------------------------------ */
:root {
  --bg: #0d1117;
  --bg-raised: #131a23;
  --bg-inset: #0a0e14;
  --border: #26303d;
  --border-strong: #37455a;
  --text: #e6edf3;
  --text-muted: #93a1b3;
  --text-faint: #6b7889;
  --accent: #38d9a9;
  --accent-dim: #1f7a63;
  --tone-info: #58a6ff;
  --tone-low: #38d9a9;
  --tone-medium: #f2cc60;
  --tone-high: #ff9f43;
  --tone-critical: #ff6b6b;
  --tone-clean: #38d9a9;
  --tone-watch: #58a6ff;
  --tone-elevated: #f2cc60;
  --radius: 10px;
  --shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
  --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

@media (prefers-color-scheme: light) {
  :root {
    --bg: #f4f6f9;
    --bg-raised: #ffffff;
    --bg-inset: #eef1f6;
    --border: #d7dde6;
    --border-strong: #b9c2cf;
    --text: #1c2430;
    --text-muted: #55606f;
    --text-faint: #7c8798;
    --shadow: 0 4px 16px rgba(20, 30, 45, 0.08);
  }
}

/* ------------------------------------------------------------------ */
/* Base                                                                */
/* ------------------------------------------------------------------ */
* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  padding: 0 0 4rem;
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.wrap {
  max-width: 1080px;
  margin: 0 auto;
  padding: 0 1.25rem;
}

a { color: var(--tone-info); text-decoration: none; }
a:hover { text-decoration: underline; }

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  background: var(--accent);
  color: #06120d;
  padding: 0.5rem 1rem;
  border-radius: 0 0 var(--radius) 0;
  font-weight: 600;
  z-index: 100;
}
.skip-link:focus { left: 0; }

/* ------------------------------------------------------------------ */
/* Report header                                                       */
/* ------------------------------------------------------------------ */
.page-header {
  border-bottom: 1px solid var(--border);
  background: linear-gradient(180deg, var(--bg-raised) 0%, var(--bg) 100%);
  padding: 2.25rem 0 1.75rem;
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--mono);
  font-size: 0.9rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1.25rem;
}

.brand-mark {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 2px solid var(--accent);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  letter-spacing: 0;
}

.page-header h1 {
  margin: 0 0 0.35rem;
  font-size: 1.9rem;
  line-height: 1.25;
  letter-spacing: -0.01em;
}

.subtitle {
  margin: 0;
  color: var(--text-muted);
  font-size: 0.92rem;
}

.subtitle code {
  font-family: var(--mono);
  color: var(--text);
  background: var(--bg-inset);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 0.05rem 0.4rem;
}

/* ------------------------------------------------------------------ */
/* Target summary card                                                 */
/* ------------------------------------------------------------------ */
.summary-card {
  margin: 1.75rem 0 0;
  background: var(--bg-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
}

.summary-cell {
  padding: 0.9rem 1.1rem;
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.summary-label {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--text-faint);
  margin-bottom: 0.25rem;
}

.summary-value {
  font-size: 1rem;
  font-weight: 600;
  word-break: break-all;
}

.summary-value.mono { font-family: var(--mono); font-weight: 500; }

/* ------------------------------------------------------------------ */
/* Risk band strip                                                     */
/* ------------------------------------------------------------------ */
.band-strip {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  margin: 1.25rem 0 0;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  font-size: 0.78rem;
  text-align: center;
}

.band-seg {
  padding: 0.5rem 0.25rem;
  background: var(--bg-inset);
  color: var(--text-faint);
  border-right: 1px solid var(--border);
  text-transform: capitalize;
}

.band-seg:last-child { border-right: none; }

.band-seg.is-active {
  color: #0b1015;
  font-weight: 700;
}

.band-seg.active-clean { background: var(--tone-clean); }
.band-seg.active-watch { background: var(--tone-watch); }
.band-seg.active-elevated { background: var(--tone-elevated); }
.band-seg.active-high { background: var(--tone-high); }
.band-seg.active-critical { background: var(--tone-critical); }

.band-score {
  text-align: center;
  color: var(--text-muted);
  font-size: 0.82rem;
  margin: 0.5rem 0 0;
}

.band-score strong { color: var(--text); font-size: 1rem; }

/* ------------------------------------------------------------------ */
/* Table of contents                                                   */
/* ------------------------------------------------------------------ */
.toc {
  margin: 2rem 0 0;
  background: var(--bg-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1rem 1.25rem;
}

.toc-title {
  margin: 0 0 0.6rem;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--text-faint);
}

.toc ol {
  margin: 0;
  padding-left: 1.25rem;
  columns: 2;
  column-gap: 2rem;
}

.toc li { margin: 0.2rem 0; break-inside: avoid; }

/* ------------------------------------------------------------------ */
/* Sections and tables                                                 */
/* ------------------------------------------------------------------ */
section.report-section {
  margin: 2rem 0 0;
  background: var(--bg-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.section-head {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  padding: 0.9rem 1.25rem;
  border-bottom: 1px solid var(--border);
  background: var(--bg-inset);
}

.section-head h2 {
  margin: 0;
  font-size: 1.1rem;
  letter-spacing: -0.01em;
}

.section-index {
  font-family: var(--mono);
  font-size: 0.75rem;
  color: var(--text-faint);
}

.section-body { padding: 0.25rem 0 0.75rem; }

.table-scroll { overflow-x: auto; }

table.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}

table.data-table caption {
  caption-side: top;
  text-align: left;
  padding: 0.6rem 1.25rem 0.2rem;
  color: var(--text-faint);
  font-size: 0.8rem;
}

table.data-table th {
  text-align: left;
  padding: 0.55rem 1.25rem;
  background: var(--bg-inset);
  color: var(--text-muted);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border-bottom: 1px solid var(--border-strong);
  white-space: nowrap;
}

table.data-table td {
  padding: 0.5rem 1.25rem;
  border-bottom: 1px solid var(--border);
  vertical-align: top;
  word-break: break-word;
}

table.data-table tbody tr:last-child td { border-bottom: none; }

table.data-table tbody tr:nth-child(even) td { background: rgba(127, 145, 170, 0.05); }

table.data-table td.num,
table.data-table th.num { text-align: right; font-variant-numeric: tabular-nums; }

.notes {
  margin: 0.6rem 1.25rem 0.5rem;
  padding: 0.65rem 0.9rem;
  border-left: 3px solid var(--accent-dim);
  background: var(--bg-inset);
  border-radius: 0 6px 6px 0;
  color: var(--text-muted);
  font-size: 0.88rem;
}

.empty-state {
  padding: 1.5rem 1.25rem;
  color: var(--text-faint);
  font-style: italic;
}

/* ------------------------------------------------------------------ */
/* Badges                                                              */
/* ------------------------------------------------------------------ */
.badge {
  display: inline-block;
  padding: 0.12rem 0.6rem;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
}

.badge.tone-info { background: rgba(88, 166, 255, 0.16); color: var(--tone-info); }
.badge.tone-low { background: rgba(56, 217, 169, 0.14); color: var(--tone-low); }
.badge.tone-medium { background: rgba(242, 204, 96, 0.14); color: var(--tone-medium); }
.badge.tone-high { background: rgba(255, 159, 67, 0.15); color: var(--tone-high); }
.badge.tone-critical { background: rgba(255, 107, 107, 0.16); color: var(--tone-critical); }
.badge.tone-neutral { background: rgba(147, 161, 179, 0.14); color: var(--text-muted); }

/* ------------------------------------------------------------------ */
/* Signal list and provenance legend                                   */
/* ------------------------------------------------------------------ */
.signal-list {
  margin: 0.6rem 1.25rem;
  padding-left: 1.2rem;
}

.signal-list li { margin: 0.22rem 0; }

.legend {
  margin: 2rem 0 0;
  background: var(--bg-raised);
  border: 1px dashed var(--border-strong);
  border-radius: var(--radius);
  padding: 1.1rem 1.25rem;
  color: var(--text-muted);
  font-size: 0.85rem;
}

.legend h2 {
  margin: 0 0 0.5rem;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--text-faint);
}

.legend ul {
  margin: 0.4rem 0 0.8rem;
  padding-left: 1.2rem;
}

.legend li { margin: 0.18rem 0; }

.legend .badge { margin-right: 0.35rem; }

/* ------------------------------------------------------------------ */
/* Footer                                                              */
/* ------------------------------------------------------------------ */
.page-footer {
  margin-top: 2.5rem;
  border-top: 1px solid var(--border);
  padding: 1.25rem 0 0;
  color: var(--text-faint);
  font-size: 0.8rem;
  text-align: center;
}

.page-footer p { margin: 0.25rem 0; }

.disclaimer {
  max-width: 62ch;
  margin: 0.5rem auto 0;
  font-style: italic;
}

/* ------------------------------------------------------------------ */
/* Responsive and print                                                */
/* ------------------------------------------------------------------ */
@media (max-width: 720px) {
  .page-header h1 { font-size: 1.45rem; }
  .toc ol { columns: 1; }
  .band-strip { grid-template-columns: 1fr; }
  .band-seg { border-right: none; border-bottom: 1px solid var(--border); }
  .band-seg:last-child { border-bottom: none; }
  .summary-cell { border-right: none; }
}

@media print {
  body { background: #ffffff; color: #000000; padding: 0; font-size: 11px; }
  .wrap { max-width: none; padding: 0; }
  .skip-link { display: none; }
  .page-header { background: none; border-bottom: 2px solid #000; padding: 0.5rem 0; }
  .summary-card, section.report-section, .toc, .legend {
    box-shadow: none;
    border: 1px solid #999;
    break-inside: avoid;
  }
  .table-scroll { overflow: visible; }
  table.data-table th { background: #efefef; color: #000; }
  table.data-table tbody tr:nth-child(even) td { background: #fafafa; }
  .band-seg { background: #efefef; color: #333; }
  .band-seg.is-active { background: #333; color: #fff; }
  a { color: #000; text-decoration: underline; }
  .page-footer { border-top: 1px solid #999; }
}
</style>
</head>
<body>
<a class="skip-link" href="#content">Skip to report content</a>

<header class="page-header">
  <div class="wrap">
    <div class="brand" aria-label="ObscuraLens">
      <span class="brand-mark" aria-hidden="true">&#9678;</span>
      <span>ObscuraLens</span>
    </div>
    <h1>{{ meta.title|esc }}</h1>
    <p class="subtitle">
      OSINT investigation report
      {%- if meta.kind %} &middot; kind <code>{{ meta.kind|esc }}</code>{% endif %}
      {%- if meta.channel %} &middot; channel <code>{{ meta.channel|esc }}</code>{% endif %}
      &middot; generated {{ meta.generated|fmt_date }}
    </p>
  </div>
</header>

<main id="content" class="wrap">

  {# ---------------- target summary card --------------------------- #}
  <section class="summary-card" aria-label="Target summary">
    <div class="summary-grid">
      <div class="summary-cell">
        <div class="summary-label">Target</div>
        <div class="summary-value mono">{{ meta.target|esc or '&mdash;' }}</div>
      </div>
      <div class="summary-cell">
        <div class="summary-label">Kind</div>
        <div class="summary-value">{{ meta.kind|esc or '&mdash;' }}</div>
      </div>
      <div class="summary-cell">
        <div class="summary-label">Engine version</div>
        <div class="summary-value mono">v{{ meta.version|esc }}</div>
      </div>
      <div class="summary-cell">
        <div class="summary-label">Generated</div>
        <div class="summary-value mono">{{ meta.generated|fmt_date }}</div>
      </div>
    </div>
  </section>

  {# ---------------- risk band strip (when a band is supplied) ----- #}
  {% if meta.band %}
  {% set bands = [
      ('clean', 'clean'),
      ('watch', 'watch'),
      ('elevated', 'elevated'),
      ('high', 'high'),
      ('critical', 'critical'),
  ] %}
  <div class="band-strip" role="img"
       aria-label="Risk band {{ meta.band|esc }}{% if meta.score is not none %} (score {{ meta.score|esc }}){% endif %}">
    {% for value, label in bands %}
    <div class="band-seg{% if meta.band == value %} is-active active-{{ value }}{% endif %}">
      {{ label }}
    </div>
    {% endfor %}
  </div>
  {% if meta.score is defined and meta.score is not none %}
  <p class="band-score">Rule score: <strong>{{ meta.score|esc }}</strong> / 100</p>
  {% endif %}
  {% endif %}

  {# ---------------- top signals (when supplied) ------------------- #}
  {% if meta.top_signals %}
  <section class="report-section" aria-labelledby="signals-heading">
    <div class="section-head">
      <span class="section-index">S0</span>
      <h2 id="signals-heading">Top Signals</h2>
    </div>
    <div class="section-body">
      <ul class="signal-list">
        {% for signal in meta.top_signals %}
        <li>{{ signal|esc }}</li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {# ---------------- table of contents ----------------------------- #}
  {% if sections %}
  <nav class="toc" aria-label="Table of contents">
    <p class="toc-title">Contents</p>
    <ol>
      {% for section in sections %}
      <li><a href="#sec-{{ loop.index }}">{{ section.title|esc }}</a></li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}

  {# ---------------- data sections --------------------------------- #}
  {% if sections %}
    {% for section in sections %}
    {{ section_table(section, loop.index) }}
    {% endfor %}
  {% else %}
  <section class="report-section" aria-labelledby="empty-heading">
    <div class="section-head">
      <span class="section-index">&mdash;</span>
      <h2 id="empty-heading">No sections</h2>
    </div>
    <div class="section-body">
      <p class="empty-state">
        This report contains no data sections. Either the underlying lookup
        returned no fields or the report was rendered from an empty run.
      </p>
    </div>
  </section>
  {% endif %}

  {# ---------------- provenance legend ----------------------------- #}
  <aside class="legend" aria-labelledby="legend-heading">
    <h2 id="legend-heading">How to read this report</h2>
    <ul>
      <li>
        {{ badge('info', 'tone-info') }}
        Context and data-quality observations: coverage gaps, neutral facts,
        positive signals. They do not raise the risk score by themselves.
      </li>
      <li>
        {{ badge('low', 'tone-low') }}
        Weak corroborating signals. Individually they justify a note, not an
        action.
      </li>
      <li>
        {{ badge('medium', 'tone-medium') }}
        Signals that usually warrant a second lookup or a pivot to a related
        indicator.
      </li>
      <li>
        {{ badge('high', 'tone-high') }}
        Strong indicators with documented abuse associations. Correlate with
        at least one other signal before acting.
      </li>
      <li>
        {{ badge('critical', 'tone-critical') }}
        Indicators that map to confirmed hostile activity (blocklist verdicts,
        ransomware clusters, KEV listing). Escalate.
      </li>
    </ul>
    <p>
      Scores are explainable sums of weighted rule hits (0-100). The risk band
      strip maps them to clean / watch / elevated / high / critical. Rules
      describe technical indicators only; they are heuristics for analysts,
      not evidence and not verdicts about people.
    </p>
  </aside>

</main>

<footer class="page-footer">
  <div class="wrap">
    <p>
      Generated by <strong>ObscuraLens</strong> v{{ meta.version|esc }}
      {%- if meta.channel %} ({{ meta.channel|esc }} channel){% endif %}
      on {{ meta.generated|fmt_date }}.
    </p>
    <p class="disclaimer">
      This document aggregates publicly available OSINT data and heuristic
      signals at a point in time. It may contain errors and stale data.
      Verify anything material through an independent source before acting
      on it.
    </p>
  </div>
</footer>

</body>
</html>
